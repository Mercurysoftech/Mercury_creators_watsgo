# ==============================================================================
# WATSGO CREATOR HUB - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real credentials.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PORT=5000

# Base API URL used by the frontend
VITE_API_URL=/api
VITE_API_BASE_URL=https://creators.watsgo.in/api

# Database Credentials (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=watsgo_creators
DB_USER=root
DB_PASSWORD=your_database_password_here

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Hostinger SMTP Settings for Live Email Delivery
# Hostinger Webmail: https://mail.hostinger.com/
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example@mail.com
SMTP_PASS=your_email_password_here
SMTP_FROM_NAME="WatsGo Creator Hub"
SMTP_FROM_EMAIL=example@mail.com

# SMS Gateway Configuration - Ping4SMS
PING4SMS_KEY=1536ssc643ef35630e636a34353535
PING4SMS_SENDER=MERSOF
PING4SMS_TEMPLATE_ID=16071000005775757
SMS_API_KEY=1536ssc643ef35630e636a34353535
SMS_SENDER_ID=MERSOF
